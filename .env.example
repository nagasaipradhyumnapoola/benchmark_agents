# Read by your shell/process supervisor; Bench Agents does not automatically execute dotenv files.
BENCH_AGENTS_DATA_DIR=.bench-agents
BENCH_AGENTS_ALLOW_HOST_PROCESS=0
# Shared source registry; omit to let the UI launcher start a separate local Hub.
# BENCH_AGENTS_HUB_URL=https://your-registry.example
# BENCH_AGENTS_HUB_DATA_DIR=.bench-agents/hub
NEXT_TELEMETRY_DISABLED=1
# Set provider secrets in the backend environment, never in NEXT_PUBLIC variables or committed files.
# Register the variable NAME in ModelConfig.api_key_env.
